{
  "expo": {
    "name": "LAON",
    "slug": "laon-dance-feedback",
    "version": "1.0.8",
    "orientation": "portrait",
    "icon": "./assets/images/LaonIcon.png",
    "scheme": "laondancefeedback",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "om.laon.dancefeedback",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSCameraUsageDescription": "댄스 영상 촬영을 위해 카메라 권한이 필요합니다.",
        "NSMicrophoneUsageDescription": "댄스 영상 촬영 시 오디오 녹음을 위해 마이크 권한이 필요합니다.",
        "NSPhotoLibraryUsageDescription": "피드백할 댄스 영상을 선택하기 위해 사진첩 접근 권한이 필요합니다.",
        "NSPhotoLibraryAddUsageDescription": "영상 및 사진을 기기 사진첩에 저장하기 위해 권한이 필요합니다."
      }
    },
    "android": {
      "package": "om.laon.dancefeedback",
      "googleServicesFile": "./google-services.json",
      "versionCode": 15,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/LaonIcon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-secure-store",
      [
        "@sentry/react-native/expo",
        {
          "organization": "laon-dance",
          "project": "laon-dance-feedback"
        }
      ],
      "expo-video",
      ["expo-media-library", { "granularPermissions": [] }],
      "expo-audio",
      "expo-asset",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false,
            "largeHeap": true
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-4292623789702109~5725434154",
          "iosAppId": "ca-app-pub-4292623789702109~8783741095"
        }
      ],
      "react-native-video",
      "./plugins/withMediaPermissionsFix"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c98740e4-c8df-45e3-83f6-1077866cf26c"
      }
    }
  }
}
